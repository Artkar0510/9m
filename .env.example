# MongoDB connection
MONGODB__HOST=localhost
MONGODB__PORT=27017
MONGODB__USER=ugc_user
MONGODB__PASSWORD=changeme
MONGODB__DB=ugc_db
MONGODB__TEST_DB=ugc_test_db

# MongoDB collections
MONGODB__COLLECTIONS__FILM_RATINGS=film_ratings
MONGODB__COLLECTIONS__REVIEWS=reviews
MONGODB__COLLECTIONS__REVIEW_LIKES=review_likes
MONGODB__COLLECTIONS__BOOKMARKS=bookmarks

# Redis
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__DB=0

# Auth service
AUTH__SERVICE_URL=http://localhost:8001
AUTH__INTROSPECT_PATH=/api/v1/auth/introspect
AUTH__TOKEN_CACHE_TTL=900

# App (docker-compose)
APP_PORT=8000
